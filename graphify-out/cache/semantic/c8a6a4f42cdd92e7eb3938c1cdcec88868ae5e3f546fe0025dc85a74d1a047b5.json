{"nodes": [{"id": "designsystem_design_system_v2", "label": "Defranez Design System v2", "file_type": "rationale", "source_file": "DesignSystem.html", "source_location": null, "source_url": null, "captured_at": null, "author": "Ezequiel De Francisco", "contributor": null, "rationale": "Single mint accent (#00F5A0) is meant to hold ~90% of attention on a near-black canvas; every other token is a hairline derived from white-alpha. Elevation is communicated by a border lifting to mint-20% on hover \u2014 never a shadow. Sharp corners by default."}, {"id": "designsystem_color_tokens", "label": "Color Tokens (Mint on Near-Black)", "file_type": "concept", "source_file": "DesignSystem.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "--bg #080A0C, --surface #0E1114, --surface2 #13171C, accent mint #00F5A0 with cyan gradient pair #00C8FF; borders are white-alpha hairlines (6%/12%)."}, {"id": "designsystem_type_system", "label": "Two-Face Type System (Syne + DM Mono)", "file_type": "concept", "source_file": "DesignSystem.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Syne (geometric humanist) for everything that breathes; wide-tracked DM Mono for everything labelled (eyebrows, nav, tags). Deliberately no third typeface on the live site."}, {"id": "designsystem_components", "label": "Component Library (Sharp / Hairline / Flat)", "file_type": "concept", "source_file": "DesignSystem.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Buttons, tags, stat tiles, project cards, skill bars, sticky nav, and pulse status rows. No radius except skill pills; no shadow."}, {"id": "designsystem_iconography", "label": "Unicode Iconography in Mono", "file_type": "concept", "source_file": "DesignSystem.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No icon library: six DM Mono unicode glyphs (\u2192 \u2197 \u2193 \u2715 \u221e \u00b7) carry every gesture. No emoji anywhere."}, {"id": "designsystem_spacing_scale", "label": "Spacing Scale and Breakpoints", "file_type": "concept", "source_file": "DesignSystem.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Strict 4-multiple scale, sections breathe at 120/60, cards sit 2px apart deliberately almost-touching, 12-col grid at 1320 max. Three tiers: Desktop >=901, Tablet <=900, Mobile <=560."}, {"id": "designsystem_motion_tokens", "label": "Motion Tokens (Gentle, Never Bouncy)", "file_type": "concept", "source_file": "DesignSystem.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named curves (orbFloat, logoSpin, pulse, --ease-image) and duration tokens 0.2s-0.8s. Hover lifts a border, never a card; the logo spins once every 40s."}, {"id": "designsystem_space_rail_builder", "label": "Space-Rail Builder Script", "file_type": "code", "source_file": "DesignSystem.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "designsystem_design_system_v2", "target": "index_portfolio_v2", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DesignSystem.html", "source_location": null, "weight": 1.0}, {"source": "designsystem_components", "target": "v1_portfolio_v1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DesignSystem.html", "source_location": null, "weight": 1.0}, {"source": "designsystem_space_rail_builder", "target": "designsystem_spacing_scale", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DesignSystem.html", "source_location": null, "weight": 1.0}, {"sourc